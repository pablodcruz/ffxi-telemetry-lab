# Required for collection. Never commit a real source path if it is sensitive.
FFXI_SOURCE_ROOT=/absolute/path/to/FFXI Agents Server

# Optional local paths. Defaults are inside this repository.
TELEMETRY_DATA_DIR=data
TELEMETRY_DUCKDB_PATH=data/warehouse/telemetry.duckdb

# One-minute local observation is sufficient for durable hourly progression.
TELEMETRY_OBSERVER_INTERVAL_SECONDS=60

# Public aggregate publishing. Pull BLOB_READ_WRITE_TOKEN into the ignored
# .env.vercel file after connecting a public Vercel Blob store.
BLOB_READ_WRITE_TOKEN=
TELEMETRY_BLOB_PATHNAME=telemetry/latest.json

# Optional read-only MariaDB snapshots. Use a dedicated SELECT-only account.
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_DATABASE=xidb
MARIADB_USER=ffxi_telemetry_reader
MARIADB_PASSWORD=
